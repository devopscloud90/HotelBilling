<%@ page import="java.util.*,java.math.*,com.stayledger.model.*,com.stayledger.web.Html" %><% request.setAttribute("pageTitle","Overview"); %><%@ include file="header.jspf" %>
<div class="stats-grid"><article class="stat-card"><span>Revenue today</span><strong>INR <%= ((BigDecimal)request.getAttribute("revenue")).setScale(2,java.math.RoundingMode.HALF_UP) %></strong><small>Payments received today</small></article><article class="stat-card"><span>Outstanding balance</span><strong>INR <%= ((BigDecimal)request.getAttribute("outstanding")).setScale(2,java.math.RoundingMode.HALF_UP) %></strong><small>Across all invoices</small></article><article class="stat-card"><span>Total invoices</span><strong><%= request.getAttribute("invoiceCount") %></strong><small>Created in this hotel account</small></article></div>
<section class="panel"><div class="panel-heading"><div><h2>Recent invoices</h2><p>Latest guest billing activity</p></div><a class="text-link" href="<%=request.getContextPath()%>/invoices">View all →</a></div><div class="table-wrap"><table><thead><tr><th>Invoice</th><th>Customer / order</th><th>Table / room</th><th>Date</th><th>Total</th><th>Status</th></tr></thead><tbody><% List<Invoice> rows=(List<Invoice>)request.getAttribute("invoices"); int n=0; for(Invoice i:rows){if(n++==8)break;%><tr><td><a href="<%=request.getContextPath()%>/invoice?id=<%=i.getId()%>"><%=Html.e(i.getNumber())%></a></td><td><%="FOOD".equals(i.getInvoiceType())?"Food order":Html.e(i.getGuestName())%></td><td><%="FOOD".equals(i.getInvoiceType())?(i.getRoomNumber()==null||i.getRoomNumber().isEmpty()?"Food":"Table "+Html.e(i.getRoomNumber())):Html.e(i.getRoomNumber())%></td><td><%=i.getIssuedOn()%></td><td>INR <%=i.getTotal()%></td><td><span class="status <%=i.getStatus().toLowerCase().replace(' ','-')%>"><%=i.getStatus()%></span></td></tr><%} if(rows.isEmpty()){%><tr><td colspan="6" class="empty-state">No invoices yet. Create your first guest invoice to get started.</td></tr><%}%></tbody></table></div></section>
<%@ include file="footer.jspf" %>
