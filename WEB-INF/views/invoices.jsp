<%@ page import="java.util.*,com.stayledger.model.*,com.stayledger.web.Html" %><% request.setAttribute("pageTitle","Invoices"); %><%@ include file="header.jspf" %>
<section class="panel"><form class="filter-bar" method="get" action="<%=request.getContextPath()%>/invoices"><input type="search" name="q" placeholder="Search guest, invoice, room" value="<%=Html.e(request.getAttribute("q"))%>"><select name="status"><option value="">All statuses</option><%String status=(String)request.getAttribute("status");for(String s:new String[]{"Paid","Partially paid","Unpaid"}){%><option <%=s.equals(status)?"selected":""%>><%=s%></option><%}%></select><button class="button secondary">Filter</button></form><div class="table-wrap"><table><thead><tr><th>Invoice</th><th>Customer / order</th><th>Table / room</th><th>Order / stay</th><th>Total</th><th>Balance</th><th>Status</th></tr></thead><tbody><%List<Invoice> rows=(List<Invoice>)request.getAttribute("invoices");for(Invoice i:rows){%><tr><td><a href="<%=request.getContextPath()%>/invoice?id=<%=i.getId()%>"><%=Html.e(i.getNumber())%></a></td><td><%="FOOD".equals(i.getInvoiceType())?"Food order":Html.e(i.getGuestName())%></td><td><%="FOOD".equals(i.getInvoiceType())?(i.getRoomNumber()==null||i.getRoomNumber().isEmpty()?"Food":"Table "+Html.e(i.getRoomNumber())):Html.e(i.getRoomNumber())%></td><td><%="FOOD".equals(i.getInvoiceType())?"Food order · "+i.getGuestCount()+" guests":i.getCheckIn()+" – "+i.getCheckOut()%></td><td>INR <%=i.getTotal()%></td><td>INR <%=i.getBalance()%></td><td><span class="status <%=i.getStatus().toLowerCase().replace(' ','-')%>"><%=i.getStatus()%></span></td></tr><%}if(rows.isEmpty()){%><tr><td colspan="7" class="empty-state">No invoices match this search.</td></tr><%}%></tbody></table></div></section>
<%@ include file="footer.jspf" %>
