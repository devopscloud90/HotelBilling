<%@ page import="com.stayledger.model.HotelSettings,com.stayledger.web.Html" %><%request.setAttribute("pageTitle","Hotel settings");HotelSettings s=(HotelSettings)request.getAttribute("settings");%><%@ include file="header.jspf" %><section class="panel form-panel"><h2>Property details</h2><p>These details appear on invoices created from now on.</p><%if("1".equals(request.getParameter("saved"))){%><div class="notice">Settings saved.</div><%}%><form method="post" action="<%=request.getContextPath()%>/settings" class="settings-form"><label>Hotel name<input name="propertyName" maxlength="120" required value="<%=Html.e(s.getPropertyName())%>"></label><label>Address<textarea name="propertyAddress" rows="3" maxlength="250"><%=Html.e(s.getPropertyAddress())%></textarea></label><label>Phone<input name="propertyPhone" maxlength="40" value="<%=Html.e(s.getPropertyPhone())%>"></label><label>Email<input type="email" name="propertyEmail" maxlength="120" value="<%=Html.e(s.getPropertyEmail())%>"></label><button class="button primary">Save settings</button></form></section><%@ include file="footer.jspf" %>
