<%@ page import="java.util.*,com.stayledger.model.MenuItem,com.stayledger.web.Html" %><%request.setAttribute("pageTitle","Food bill");List<MenuItem> menuItems=(List<MenuItem>)request.getAttribute("menuItems");%><%@ include file="header.jspf" %>
<%if(menuItems.isEmpty()){%><section class="panel error-panel"><h2>Add menu items first</h2><p>Create available food items and their INR rates before making a bill.</p><a class="button primary" href="<%=request.getContextPath()%>/menu">Manage food menu</a></section><%}else{%>
<form method="post" action="<%=request.getContextPath()%>/invoice" class="form-layout"><input type="hidden" name="_csrf" value="<%=Html.e(request.getAttribute("csrfToken"))%>">
<section class="panel form-panel"><div class="panel-heading"><div><h2>Order details</h2><p>Customer details are not required for a walk-in order.</p></div><a class="text-link" href="<%=request.getContextPath()%>/menu">Manage menu and rates →</a></div><label class="table-field">Table number <span class="optional">Optional · leave blank for takeaway</span><input name="tableNumber" maxlength="20" placeholder="e.g. 4"></label></section>
<section class="panel form-panel"><div class="panel-heading"><div><h2>Food items</h2><p>Choose an item and quantity. Line amounts and bill total update automatically.</p></div><button type="button" class="button secondary" onclick="addFoodItem()">＋ Add item</button></div><div id="foodItems"><div class="food-row"><select name="itemId" onchange="updateBill()" required><option value="">Select food item</option><%for(MenuItem item:menuItems){%><option value="<%=item.getId()%>" data-price="<%=item.getPrice()%>"><%=Html.e(item.getName())%> · INR <%=item.getPrice()%></option><%}%></select><input name="itemQuantity" type="number" min="1" max="999" step="1" value="1" aria-label="Quantity" oninput="updateBill()" required><output class="food-line-total">INR 0.00</output><button type="button" class="remove-charge" onclick="removeFoodItem(this)" aria-label="Remove item">×</button></div></div><div class="food-subtotal"><span>Food subtotal</span><strong id="foodSubtotal">INR 0.00</strong></div></section>
<section class="panel form-panel"><h2>Discount, tax and payment</h2><div class="form-grid"><label>Discount (INR) <input name="discount" type="number" min="0" step="0.01" value="0" oninput="updateBill()"></label><label>Tax rate (%) <input name="taxRate" type="number" min="0" max="100" step="0.01" value="0" oninput="updateBill()"></label><label>Amount paid now (INR) <input name="amountPaid" type="number" min="0" step="0.01" value="0"></label><label>Payment method <select name="paymentMethod"><option>Cash</option><option>Card</option><option>UPI</option><option>Bank transfer</option></select></label></div><div class="food-grand-total"><span>Estimated total</span><strong id="billTotal">INR 0.00</strong></div></section>
<div class="form-actions"><a class="button secondary" href="<%=request.getContextPath()%>/invoices">Cancel</a><button class="button primary">Create food bill</button></div></form>
<script>
function money(value){return 'INR '+(Number(value)||0).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2});}
function updateBill(){var subtotal=0;document.querySelectorAll('#foodItems .food-row').forEach(function(row){var select=row.querySelector('[name=itemId]');var qty=Number(row.querySelector('[name=itemQuantity]').value)||0;var price=Number(select.selectedOptions[0].dataset.price)||0;var amount=qty*price;subtotal+=amount;row.querySelector('.food-line-total').textContent=money(amount);});document.getElementById('foodSubtotal').textContent=money(subtotal);var discount=Number(document.querySelector('[name=discount]').value)||0;var taxable=Math.max(0,subtotal-discount);var taxRate=Number(document.querySelector('[name=taxRate]').value)||0;document.getElementById('billTotal').textContent=money(taxable+taxable*taxRate/100);}
function addFoodItem(){var row=document.querySelector('#foodItems .food-row').cloneNode(true);row.querySelector('[name=itemId]').value='';row.querySelector('[name=itemQuantity]').value='1';row.querySelector('.food-line-total').textContent='INR 0.00';document.getElementById('foodItems').appendChild(row);updateBill();}
function removeFoodItem(button){var rows=document.querySelectorAll('#foodItems .food-row');if(rows.length>1)button.parentElement.remove();else{button.parentElement.querySelector('[name=itemId]').value='';button.parentElement.querySelector('[name=itemQuantity]').value='1';}updateBill();}
</script><%}%>
<%@ include file="footer.jspf" %>
