<%@ page import="java.util.*,com.stayledger.model.MenuItem,com.stayledger.web.Html" %><%request.setAttribute("pageTitle","Food menu and rates");%><%@ include file="header.jspf" %>
<section class="panel form-panel"><h2>Add an available item</h2><p>Food items and INR rates appear in the bill item selector.</p><%if("1".equals(request.getParameter("saved"))){%><div class="notice">Menu saved.</div><%}%><form method="post" action="<%=request.getContextPath()%>/menu" class="menu-add-form"><input type="hidden" name="action" value="add"><label>Food item<input name="name" maxlength="80" placeholder="e.g. Masala dosa" required></label><label>Rate (INR)<input name="price" type="number" min="0.01" step="0.01" placeholder="0.00" required></label><button class="button primary">＋ Add item</button></form></section>
<section class="panel"><div class="panel-heading"><div><h2>Available items and rates</h2><p>Update a rate or mark an item unavailable.</p></div><a class="text-link" href="<%=request.getContextPath()%>/invoice">Create food bill →</a></div><div class="menu-item-list"><%List<MenuItem> items=(List<MenuItem>)request.getAttribute("menuItems");for(MenuItem item:items){%><form method="post" action="<%=request.getContextPath()%>/menu" class="menu-item-row"><input type="hidden" name="action" value="update"><input type="hidden" name="itemId" value="<%=item.getId()%>"><label>Food item<input name="name" maxlength="80" value="<%=Html.e(item.getName())%>" required></label><label>Rate (INR)<input type="number" name="price" min="0.01" step="0.01" value="<%=item.getPrice()%>" required></label><label>Availability<select name="active"><option value="Y" <%="Y".equals(item.getActive())?"selected":""%>>Available</option><option value="N" <%="N".equals(item.getActive())?"selected":""%>>Unavailable</option></select></label><button class="button secondary">Save</button></form><%}%><%if(items.isEmpty()){%><p class="empty-state">No menu items yet. Add a food item and rate above.</p><%}%></div></section>
<%@ include file="footer.jspf" %>
