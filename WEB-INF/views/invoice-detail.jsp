<%@ page import="com.stayledger.model.*,com.stayledger.web.Html" %><%Invoice i=(Invoice)request.getAttribute("invoice");boolean food="FOOD".equals(i.getInvoiceType());request.setAttribute("pageTitle",(food?"Food bill ":"Invoice ")+i.getNumber());%><%@ include file="header.jspf" %>
<section class="panel invoice-paper"><div class="panel-heading"><div><h2><%=Html.e(i.getPropertyName())%></h2><p><%=Html.e(i.getPropertyAddress())%> · <%=Html.e(i.getPropertyPhone())%></p></div><button class="button secondary no-print" onclick="window.print()">Print bill</button></div><div class="invoice-meta"><div><span><%=food?"Food bill":"Invoice"%> number</span><strong><%=Html.e(i.getNumber())%></strong></div><div><span>Issued</span><strong><%=i.getIssuedOn()%></strong></div><div><span>Payment status</span><strong><%=i.getStatus()%></strong></div></div><hr>
<div class="detail-grid"><%if(!food){%><div><small>GUEST</small><strong><%=Html.e(i.getGuestName())%></strong><span><%=Html.e(i.getPhone())%> · <%=Html.e(i.getEmail())%></span></div><%}%><div><small><%=food?"ORDER":"STAY"%></small><strong><%=food?(i.getRoomNumber()==null||i.getRoomNumber().isEmpty()?"Hotel food order":"Table "+Html.e(i.getRoomNumber())):"Room "+Html.e(i.getRoomNumber())+" · "+Html.e(i.getRoomType())%></strong><span><%=food?"Food order":i.getCheckIn()+" to "+i.getCheckOut()+" · "+i.getNights()+" nights · "+i.getGuestCount()+" guests"%></span></div></div>
<div class="table-wrap"><table><thead><tr><th><%=food?"Food item":"Description"%></th><th>Qty / Rate</th><th>Amount</th></tr></thead><tbody><%if(!food){%><tr><td>Room · <%=Html.e(i.getRoomType())%></td><td><%=i.getNights()%> nights × INR <%=i.getNightlyRate()%></td><td>INR <%=i.getRoomSubtotal()%></td></tr><%}%><%for(Charge c:i.getCharges()){%><tr><td><%=Html.e(c.getDescription())%></td><td><%=c.getQuantity().stripTrailingZeros().toPlainString()%> × INR <%=c.getUnitPrice()%></td><td>INR <%=c.getAmount()%></td></tr><%}%></tbody></table></div>
<div class="totals"><div><span>Subtotal</span><strong>INR <%=i.getSubtotal()%></strong></div><div><span>Discount</span><strong>− INR <%=i.getDiscount()%></strong></div><div><span>Tax (<%=i.getTaxRate()%>%)</span><strong>INR <%=i.getTax()%></strong></div><div class="grand-total"><span>Total</span><strong>INR <%=i.getTotal()%></strong></div><div><span>Paid</span><strong>INR <%=i.getPaid()%></strong></div><div><span>Balance due</span><strong>INR <%=i.getBalance()%></strong></div></div></section>
<%if(i.getBalance()!=null&&i.getBalance().signum()>0){%><section class="panel form-panel no-print"><h2>Record a payment</h2><form class="payment-form" method="post" action="<%=request.getContextPath()%>/payment"><input type="hidden" name="_csrf" value="<%=Html.e(request.getAttribute("csrfToken"))%>"><input type="hidden" name="id" value="<%=i.getId()%>"><label>Amount (INR)<input name="amount" type="number" min="0.01" max="<%=i.getBalance()%>" step="0.01" required></label><label>Method<select name="paymentMethod"><option>Cash</option><option>Card</option><option>UPI</option><option>Bank transfer</option></select></label><button class="button primary">Record payment</button></form></section><%}%><%@ include file="footer.jspf" %>
