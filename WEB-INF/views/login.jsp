<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="com.stayledger.web.Html" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Staff login · Stayledger</title><link rel="stylesheet" href="<%=request.getContextPath()%>/styles.css"><link rel="stylesheet" href="<%=request.getContextPath()%>/app-java.css"><link rel="stylesheet" href="<%=request.getContextPath()%>/food.css"><style>body{min-height:100vh;display:grid;place-items:center;padding:20px;background:#f5f7f5}.auth-card{width:min(100%,390px);padding:30px;border:1px solid #e7ece9;border-radius:14px;background:#fff;box-shadow:0 8px 30px #183d350d}.auth-brand{display:flex;align-items:center;gap:11px;margin-bottom:26px;color:#284b3a}.auth-brand .brand-mark{display:grid;width:42px;height:42px;place-items:center;border-radius:13px;background:#214c40;color:white;font-size:20px;font-weight:bold}.auth-brand small{display:block;color:#84928a;font-size:9px;letter-spacing:.08em}.auth-card h1{margin:0 0 6px;color:#233833;font-size:23px}.auth-card p{margin:0 0 20px;color:#7e8a83;font-size:12px}.auth-card form{display:grid;gap:12px}.auth-card label{display:grid;gap:5px;color:#65736c;font-size:11px;font-weight:600}.auth-card input{box-sizing:border-box;width:100%;min-height:40px;padding:0 11px;border:1px solid #dfe7e2;border-radius:7px;font-size:13px}.auth-card button{min-height:40px;border:0;border-radius:7px;background:#214c40;color:white;font-size:12px;font-weight:700;cursor:pointer}.auth-error{margin:0 0 15px!important;padding:10px;border-radius:7px;background:#fff0e9;color:#a64f3f!important}.auth-note{margin-top:17px!important;font-size:10px!important}</style></head><body><main class="auth-card"><div class="auth-brand"><span class="brand-mark">S</span><span><strong>Stayledger</strong><small>HOTEL BILLING</small></span></div><h1>Staff login</h1><p>Sign in to manage hotel bills and payments.</p><%if(request.getAttribute("errorMessage")!=null){%><p class="auth-error"><%=Html.e(request.getAttribute("errorMessage"))%></p><%}%><form method="post" action="<%=request.getContextPath()%>/login"><label>Username<input name="username" autocomplete="username" maxlength="80" required autofocus></label><label>Password<input name="password" type="password" autocomplete="current-password" required></label><button type="submit">Sign in</button></form><p class="auth-note">First time here? Open this app on the server itself to create the administrator login.</p></main></body></html>
