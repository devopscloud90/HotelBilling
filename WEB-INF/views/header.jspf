<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="com.stayledger.web.Html" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= Html.e(request.getAttribute("pageTitle")) %> · Stayledger</title><link rel="stylesheet" href="<%= request.getContextPath() %>/styles.css"><link rel="stylesheet" href="<%= request.getContextPath() %>/settings.css"><link rel="stylesheet" href="<%= request.getContextPath() %>/app-java.css"><link rel="stylesheet" href="<%= request.getContextPath() %>/food.css"></head><body>
<div class="app-shell"><aside class="sidebar"><a class="brand" href="<%= request.getContextPath() %>/dashboard"><span class="brand-mark">S</span><span><strong>Stayledger</strong><small>HOTEL BILLING</small></span></a><nav class="nav"><a href="<%= request.getContextPath() %>/dashboard">▦ <span>Overview</span></a><a href="<%= request.getContextPath() %>/invoices">▤ <span>Invoices</span></a><a href="<%= request.getContextPath() %>/invoice">＋ <span>New food bill</span></a><a href="<%= request.getContextPath() %>/menu">☷ <span>Food menu</span></a><a href="<%= request.getContextPath() %>/settings">⚙ <span>Hotel settings</span></a></nav><div class="sidebar-foot">Simple, clear hotel billing</div></aside><main class="main-content"><header class="topbar"><div><span class="eyebrow">HOTEL BILLING</span><h1><%= Html.e(request.getAttribute("pageTitle")) %></h1></div><a class="button primary" href="<%= request.getContextPath() %>/invoice">＋ New food bill</a></header><div class="page-content">
